.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

.route-item {
  margin: 24rpx 28rpx;
  background: var(--card-solid);
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.route-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-green {
  background: #22b08c;
}

.dot-red {
  background: #f04137;
}

.route-name {
  font-size: 28rpx;
  color: var(--text-strong);
  font-weight: 500;
}

.route-foot {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--divider);
  display: flex;
  justify-content: space-between;
}

.route-campus {
  font-size: 20rpx;
  color: var(--c-primary);
}

.route-tip {
  font-size: 20rpx;
  color: var(--text-muted);
}
