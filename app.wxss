/* ===== 全局主题变量（CSS 变量） ===== */
page {
  /* 主题色（默认湖水蓝） */
  --c-primary: #1464e0;
  --c-primary-deep: #0a3c91;
  --c-primary-soft: rgba(20, 100, 224, 0.10);
  --c-primary-shadow: rgba(20, 100, 224, 0.28);
  --c-primary-border: rgba(20, 100, 224, 0.15);
  --c-glass-top: rgba(20, 100, 224, 0.80);
  --c-glass-bottom: rgba(10, 60, 145, 0.66);

  /* 明暗模式 */
  --bg: #eef3fa;
  --glass: rgba(255, 255, 255, 0.74);
  --glass-strong: rgba(255, 255, 255, 0.9);
  --glass-solid: #ffffff;
  --card-solid: #ffffff;
  --text-strong: #1b2430;
  --text: #4a5868;
  --text-sub: #7a8a9f;
  --text-muted: #9aa7b8;
  --soft: #f0f4f9;
  --divider: #f0f4f9;

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-strong);
  -webkit-font-smoothing: antialiased;
}

/* ===== 深色模式 ===== */
.dark {
  --bg: #12151d;
  --glass: rgba(38, 44, 56, 0.85);
  --glass-strong: rgba(38, 44, 56, 0.95);
  --glass-solid: #20242e;
  --card-solid: #20242e;
  --text-strong: #e8ecf2;
  --text: #c2cbd8;
  --text-sub: #8d98a9;
  --text-muted: #667386;
  --soft: #262c38;
  --divider: #2a3140;
}

/* 秦岭翠绿 */
.theme-forest {
  --c-primary: #0e9f6e;
  --c-primary-deep: #065f46;
  --c-primary-soft: rgba(14, 159, 110, 0.12);
  --c-primary-shadow: rgba(14, 159, 110, 0.30);
  --c-primary-border: rgba(14, 159, 110, 0.18);
  --c-glass-top: rgba(14, 159, 110, 0.82);
  --c-glass-bottom: rgba(6, 95, 70, 0.70);
}

/* 丹霞夕照 */
.theme-sunset {
