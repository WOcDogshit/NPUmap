.page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.route-map {
  flex: 1;
  width: 100%;
}

.panel {
  background: var(--glass);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 30rpx rgba(27, 36, 48, 0.12);
  max-height: 58vh;
  display: flex;
  flex-direction: column;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.chips {
  display: flex;
}

.chip {
  font-size: 22rpx;
  border-radius: 26rpx;
  padding: 6rpx 18rpx;
  margin-left: 12rpx;
}

.chip-time {
  background: rgba(20, 100, 224, 0.10);
  background: var(--c-primary-soft);
  color: #1464e0;
  color: var(--c-primary);
}

.chip-dist { background: rgba(34, 176, 140, 0.12); color: #1a8f72; }

.route-head {
  background: var(--soft);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.point-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.point-row:last-child {
  margin-bottom: 0;
}

.point-edit {
  margin-left: auto;
  font-size: 24rpx;
  color: #1464e0;
  color: var(--c-primary);
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dot-green { background: #22b08c; }
.dot-red { background: #f04137; }

.point-name {
  font-size: 27rpx;
  color: var(--text-strong);
}

.state {
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

.state.error {
  color: #f04137;
}

.steps {
  flex: 1;
  min-height: 0;
  max-height: none;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.step {
  display: flex;
  padding: 6rpx 0;
}

.step-left {
  width: 44rpx;
  position: relative;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
}

.step-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: #dce6f3;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1464e0, #4f8dff);
  background: var(--c-primary);
  margin-top: 8rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 0 6rpx rgba(20, 100, 224, 0.10);
  box-shadow: 0 0 0 6rpx var(--c-primary-soft);
}

.step-text {
  flex: 1;
  padding: 6rpx 0 22rpx 8rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

.step-dist {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--soft);
  border-radius: 10rpx;
  padding: 2rpx 14rpx;
}

.actions {
  display: flex;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-fav {
  background: var(--soft);
  color: var(--text);
}

.btn-fav.on {
  background: rgba(245, 166, 35, 0.16);
  color: #b7791f;
}

.btn-change {
  background: var(--soft);
  color: #1464e0;
  color: var(--c-primary);
  font-weight: 600;
  margin-right: 16rpx;
}

.btn-back {
  background: linear-gradient(135deg, #1464e0, #0a3c91);
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-deep));
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(20, 100, 224, 0.25);
  box-shadow: 0 8rpx 20rpx var(--c-primary-shadow);
}

/* ===== 起点选择弹层 ===== */
.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(27, 36, 48, 0.45);
  z-index: 40;
}

.picker {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: calc(16rpx + constant(safe-area-inset-bottom));
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 41;
  background: var(--glass);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 32rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -6rpx 30rpx rgba(27, 36, 48, 0.2);
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid var(--divider);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.picker-close {
  color: var(--text-muted);
  font-size: 32rpx;
  padding: 0 8rpx;
}

.picker-list {
  max-height: 60vh;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-emoji {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.emoji-loc { background: rgba(27, 36, 48, 0.06); }
.emoji-blue   { background: rgba(20, 100, 224, 0.10); }
.emoji-green  { background: rgba(34, 176, 140, 0.12); }
.emoji-orange { background: rgba(255, 138, 61, 0.14); }
.emoji-red    { background: rgba(240, 65, 55, 0.10); }
.emoji-purple { background: rgba(155, 89, 182, 0.12); }

.picker-info {
  flex: 1;
  min-width: 0;
}

.picker-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.picker-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 实时导航 ===== */
.nav-start {
  margin-top: 20rpx;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-deep));
  box-shadow: 0 10rpx 24rpx var(--c-primary-shadow);
  flex-shrink: 0;
  white-space: nowrap;
}

.nav-panel {
  padding-bottom: calc(36rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.nav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.nav-exit {
  font-size: 26rpx;
  font-weight: 600;
  color: #f04137;
  padding: 8rpx 26rpx;
  border: 2rpx solid rgba(240, 65, 55, 0.4);
  border-radius: 34rpx;
}

.nav-instruction {
  margin-top: 26rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-strong);
  line-height: 1.45;
}

.nav-meta {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.nav-remain {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.nav-sep {
  margin: 0 16rpx;
  color: var(--text-muted);
}

.nav-time {
  font-size: 28rpx;
  color: var(--text-sub);
}

.nav-hint {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 步行 / 骑行切换 ===== */
.mode-switch {
  display: flex;
  background: var(--soft);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-sub);
  transition: all 0.25s ease;
}

.mode-tab.active {
  background: var(--glass-strong);
  color: var(--c-primary);
  box-shadow: 0 4rpx 12rpx rgba(27, 36, 48, 0.08);
}

/* 面板底部固定区（开始导航 + 操作栏，不随内容跳动） */
.panel-foot {
  margin-top: 16rpx;
  flex-shrink: 0;
}

/* 导航面板：更紧凑沉浸 */
.nav-panel {
  padding-top: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.nav-panel .nav-instruction {
  margin-top: 18rpx;
  font-size: 36rpx;
}

.nav-panel .nav-meta {
  margin-top: 14rpx;
}

.nav-panel .nav-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
}

