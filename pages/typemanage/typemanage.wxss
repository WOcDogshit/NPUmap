
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}


.hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin: 0 12rpx 20rpx;
  line-height: 1.6;
}


.card {
  background: var(--glass);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(27, 36, 48, 0.05);
}


.card {
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
}

.type-row {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--divider);
}

.type-row:last-child {
  border-bottom: none;
}


.type-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--soft);
}

.type-info {
  flex: 1;
  min-width: 0;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.type-count {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

