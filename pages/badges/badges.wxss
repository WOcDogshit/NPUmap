.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

.progress-card {
  margin: 24rpx 28rpx;
  background: var(--card-solid);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.progress-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.progress-num {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.progress-bar {
  margin-top: 18rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--soft);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--c-primary), var(--c-primary-deep));
  transition: width 0.4s ease;
}

.progress-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 8rpx 28rpx;
}

.badge-item {
  width: 48%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  background: var(--card-solid);
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.badge-item.locked {
  opacity: 0.45;
  filter: grayscale(1);
}

.badge-icon {
  font-size: 72rpx;
}

.badge-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.badge-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-sub);
  text-align: center;
}

.badge-state {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--c-primary);
}

.badge-item.locked .badge-state {
  color: var(--text-muted);
}
