.page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: var(--bg);
}

/* 顶部渐变头部 */
.hero {
  position: relative;
  z-index: 30;
  margin: 20rpx 20rpx 0;
  padding: 28rpx 28rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--c-glass-top), var(--c-glass-bottom));
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 12rpx 32rpx rgba(10, 60, 145, 0.25);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-greet {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-sub {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.more-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.search-wrap {
  margin-top: 26rpx;
  background: var(--glass-strong);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 46rpx;
  height: 84rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(10, 60, 145, 0.15);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-strong);
}

.search-placeholder {
  color: var(--text-sub);
}

.search-clear {
  color: var(--text-sub);
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* 地图铺满剩余区域 */
.campus-map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* 定位按钮 */
/* 顶部工具栏：校区切换 + 定位按钮同一行 */
.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 28rpx 0;
}

/* 校区切换条 */
.campus-switch {
  position: relative;
  z-index: 30;
  display: inline-flex;
  margin: 0;
  background: var(--glass-strong);
  border-radius: 36rpx;
  padding: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.14);
  backdrop-filter: blur(20rpx);
}

/* 滑动指示器：切换校区时平滑滑到另一边 */
.campus-slider {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: 150rpx;
  border-radius: 30rpx;
  background: var(--c-primary);
  box-shadow: 0 6rpx 18rpx var(--c-primary-shadow);
  transition: left 0.3s ease;
  z-index: 1;
}

.campus-tab {
  position: relative;
  z-index: 2;
  width: 150rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text);
  transition: color 0.25s ease;
}

.campus-tab.active {
  color: #ffffff;
  font-weight: 600;
}

.locate-btn {
  position: relative;
  z-index: 20;
  margin: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--glass-solid);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(27, 36, 48, 0.18);
  border: 2rpx solid var(--c-primary-border);
}

/* 底部地点列表 */
.poi-list {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 15;
  background: var(--glass);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 32rpx;
  box-shadow: 0 -6rpx 30rpx rgba(27, 36, 48, 0.12);
  max-height: 48vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.poi-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.poi-list-left {
  display: flex;
  flex-direction: column;
}

.poi-list-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.poi-header-right {
  display: flex;
  align-items: center;
}

.poi-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--c-primary-soft);
  border: 2rpx solid var(--c-primary-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* CSS 圆角箭头（展开朝下 / 收起朝上，平滑旋转） */
.chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--c-primary);
  border-bottom: 4rpx solid var(--c-primary);
  border-radius: 2rpx;
  transform: rotate(45deg);
  transition: transform 0.25s ease;
  margin-top: -4rpx;
}

.chevron.up {
  transform: rotate(225deg);
  margin-top: 4rpx;
}

.poi-list.collapsed {
  max-height: none;
}


.poi-list-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.poi-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.poi-scroll {
  max-height: 38vh;
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.35s ease, opacity 0.3s ease;
}

.poi-scroll.hide {
  max-height: 0;
  opacity: 0;
}

.poi-item {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.poi-item:last-child {
  border-bottom: none;
}

.poi-emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.emoji-blue   { background: rgba(20, 100, 224, 0.10); }
.emoji-green  { background: rgba(34, 176, 140, 0.12); }
.emoji-orange { background: rgba(255, 138, 61, 0.14); }
.emoji-red    { background: rgba(240, 65, 55, 0.10); }
.emoji-purple { background: rgba(155, 89, 182, 0.12); }

.poi-info {
  flex: 1;
  min-width: 0;
}

.poi-name-row {
  display: flex;
  align-items: center;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.pin-badge {
  font-size: 18rpx;
  color: #ffffff;
  background: var(--c-primary);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 10rpx;
}

.poi-pin {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.poi-pin.on {
  background: var(--c-primary-soft);
  opacity: 1;
}

.poi-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-arrow {
  color: #c4cfdc;
  font-size: 40rpx;
  margin-left: 12rpx;
}
